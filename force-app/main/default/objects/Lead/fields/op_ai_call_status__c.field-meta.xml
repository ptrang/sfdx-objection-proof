    <required>false</required>
    <type>Picklist</type>
    <valueSet>
        <restricted>true</restricted>
        <valueSetDefinition>
            <sorted>false</sorted>
            <value>
                <fullName>call</fullName>
                <default>false</default>
                <label>Call</label>
            </value>
            <value>
                <fullName>queued</fullName>
                <default>false</default>
                <label>Queued</label>
            </value>
            <value>
                <fullName>failed</fullName>
                <default>false</default>
                <label>Failed</label>
            </value>
            <value>
                <fullName>complete</fullName>
                <default>false</default>
                <label>Complete</label>
            </value>
        </valueSetDefinition>
    </valueSet>
</CustomField>
